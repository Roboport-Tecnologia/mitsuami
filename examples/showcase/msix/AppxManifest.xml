<?xml version="1.0" encoding="utf-8"?>
<!--
  The showcase's MSIX package: `scripts\package-msix.ps1` builds it.
  The script fills in the version and architecture; the identity is the
  Store's (Partner Center, Product identity).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="RoboportTecnologia.Mitsuami"
    Publisher="CN=8FF5577D-629B-4660-A180-2F881DE36F4E"
    Version="$(Version)"
    ProcessorArchitecture="$(Architecture)" />

  <Properties>
    <DisplayName>mitsuami showcase</DisplayName>
    <PublisherDisplayName>Roboport Tecnologia</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 17763 (Windows 10 1809): the Windows App Runtime 2.x's own floor. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Windows App Runtime 2.4 or later, which the Store installs with the app. -->
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.2"
      MinVersion="2.4.0.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Showcase" Executable="showcase.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="mitsuami showcase"
        Description="Every mitsuami example in one window, in the platform's own controls."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
