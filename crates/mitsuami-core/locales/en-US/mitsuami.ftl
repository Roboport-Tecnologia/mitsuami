# mitsuami's own strings: what the backends put in the app's chrome
# themselves. An app can give any of them in its own files, in any
# language, and its own win.

## The app menu and the Edit menu on macOS. $app is the app's name.

mitsuami-menu-about = About { $app }
mitsuami-menu-settings = Settings…
mitsuami-menu-hide = Hide { $app }
mitsuami-menu-quit-app = Quit { $app }
# The app's File menu goes before Edit: it's the one with this title.
mitsuami-menu-file = File
mitsuami-menu-edit = Edit
mitsuami-menu-undo = Undo
mitsuami-menu-redo = Redo
mitsuami-menu-cut = Cut
mitsuami-menu-copy = Copy
mitsuami-menu-paste = Paste
mitsuami-menu-select-all = Select All

## GNOME's primary menu and KDE's drawer.

mitsuami-menu-quit = Quit
mitsuami-main-menu = Main Menu

## Logging out: why the app holds the session's end, which GNOME's and
## Windows' log out screens show while it asks before quitting.

mitsuami-quit-reason = Asking before it quits

## Alerts.

# The button of an alert the app gave none.
mitsuami-alert-ok = OK
