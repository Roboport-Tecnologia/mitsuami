<?xml version="1.0" encoding="utf-8"?>
<!--
  The files example's MSIX package: `scripts\package-msix.ps1 -App files`
  builds it. The script fills in the version and architecture; the
  identity is the Store's (Partner Center, Product identity).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop6">

  <Identity
    Name="PLACEHOLDER.MitsuamiFiles"
    Publisher="CN=00000000-0000-0000-0000-000000000000"
    Version="$(Version)"
    ProcessorArchitecture="$(Architecture)" />

  <Properties>
    <DisplayName>Files</DisplayName>
    <PublisherDisplayName>PLACEHOLDER</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- A file manager's folders and files are the user's: without this,
         what it makes under AppData would go to the package's private copy,
         which only it sees and which goes with it when it's uninstalled. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <!-- 17763 (Windows 10 1809): the Windows App Runtime 2.x's own floor. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Windows App Runtime 2.4 or later, which the Store installs with the app. -->
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.2"
      MinVersion="2.4.0.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Files" Executable="files.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Files"
        Description="A file browser made with mitsuami, in the platform's own controls."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- runFullTrust runs it outside the app container, so it reads and
       writes wherever the user can; unvirtualizedResources allows turning
       off the AppData redirection above. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
